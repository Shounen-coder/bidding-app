# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bidding_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
